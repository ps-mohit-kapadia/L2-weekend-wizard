# Local Ollama chat endpoint used by model discovery and model calls.
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# LLM provider selection:
# - ollama: local Ollama runtime
# - aiplatform: company AI platform endpoint
LLM_PROVIDER=ollama

# Model identifier used by the selected provider.
MODEL=llama3.1:8b

# AI Platform settings. Keep these unset when using Ollama.
# AIPLATFORM_API_KEY=<secret-key>:<public-key>
AIPLATFORM_API_KEY=
AIPLATFORM_BASE_URL=https://aiapidev.3ecompany.com
AIPLATFORM_TIMEOUT=120
AIPLATFORM_CHAT_PATH=/v1/chat/completions

# Long-running timeout for Ollama model calls and chat client requests.
WEEKEND_WIZARD_REQUEST_TIMEOUT=1200

# External tool HTTP timeout for weather, books, joke, dog, and trivia fetches.
WEEKEND_WIZARD_TOOL_HTTP_TIMEOUT=20

# Number of retry attempts for external tool HTTP requests after the first try.
WEEKEND_WIZARD_HTTP_MAX_RETRIES=2

# Base retry backoff in seconds for external tool HTTP retries.
WEEKEND_WIZARD_HTTP_RETRY_BACKOFF_SECONDS=0.5

# Application log level.
WEEKEND_WIZARD_LOG_LEVEL=WARNING  # Use INFO for debugging

# Backend API base URL used by the Streamlit app.
WEEKEND_WIZARD_API_URL=http://127.0.0.1:8000

# Claude SDK notes:
# - SDK dry-run commands do not require Claude authentication.
# - Live SDK runner commands require valid Claude SDK / Claude Code auth available in the environment.
# - Live SDK smoke currently pre-checks ANTHROPIC_API_KEY.
# - Alternative company Claude Code auth paths are still pending clarification on this branch.
