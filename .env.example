# =============================================================================
# WEEKEND WIZARD - Environment Configuration
# =============================================================================
#
# PURPOSE:
#   Template configuration file for Weekend Wizard application.
#   Copy this file to .env and fill in your values.
#
# USAGE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in required values for your environment
#   3. Never commit .env to version control
#
# SECURITY WARNING:
#   - This file contains SECRET markers for sensitive values
#   - Never commit real API keys, tokens, or passwords to version control
#   - Use environment-specific secret management in production
#   - The .env file is excluded from git - keep it that way
#
# =============================================================================


# =============================================================================
# SECTION 1: Application API Configuration
# =============================================================================
# Settings for the Weekend Wizard backend API server and client connections.
# These control how the Streamlit frontend communicates with the FastAPI backend.

# API authentication key shared between frontend and backend.
# (SECRET) - Use a strong, unique key in production environments.
# Example: weekend-wizard-local-dev-2026-shared-secret
WEEKEND_WIZARD_API_KEY=

# Backend API server hostname.
# Default: 127.0.0.1 (localhost)
# Valid values: Any valid hostname or IP address
WEEKEND_WIZARD_API_HOST=127.0.0.1

# Backend API server port.
# Default: 8000
# Valid values: 1-65535 (avoid privileged ports < 1024 in production)
WEEKEND_WIZARD_API_PORT=8000

# Backend API base URL used by the Streamlit app.
# Constructed from API_HOST and API_PORT by default.
# Example: http://127.0.0.1:8000
WEEKEND_WIZARD_API_URL=http://127.0.0.1:8000


# =============================================================================
# SECTION 2: LLM Provider Configuration
# =============================================================================
# Settings for selecting and configuring the LLM backend provider.
# Weekend Wizard supports multiple LLM backends for flexibility.

# LLM provider selection.
# Valid values: 'ollama' | 'aiplatform'
# - ollama: Local Ollama runtime (default, no API key required)
# - aiplatform: Company AI platform endpoint (requires API key)
LLM_PROVIDER=ollama

# Primary model identifier for the selected provider.
# The model must be available in your chosen provider.
# Examples:
#   - Ollama: llama3.1:8b, mistral:7b, codellama:13b
#   - AI Platform: 3eco/zai-org/glm-5, gpt-4, claude-3-opus
MODEL=llama3.1:8b

# Preferred models list for model selection UI or fallback.
# Comma-separated list of model identifiers.
# Used when the primary MODEL is unavailable or for multi-model workflows.
# Example: llama3.1:8b,mistral:7b,codellama:13b
WEEKEND_WIZARD_PREFERRED_MODELS=llama3.1:8b


# =============================================================================
# SECTION 3: Ollama Configuration
# =============================================================================
# Settings for local Ollama runtime integration.
# Only applies when LLM_PROVIDER=ollama.
# These settings are ignored when using AI Platform.

# Ollama chat endpoint URL.
# Used for model inference and chat completions.
# Default: http://127.0.0.1:11434/api/chat
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Ollama tags endpoint URL.
# Used for model discovery and listing available models.
# Default: http://127.0.0.1:11434/api/tags
OLLAMA_TAGS_URL=http://127.0.0.1:11434/api/tags


# =============================================================================
# SECTION 4: AI Platform Configuration
# =============================================================================
# Settings for company AI platform integration.
# Only applies when LLM_PROVIDER=aiplatform.
# Keep these unset when using Ollama to avoid confusion.

# AI Platform API authentication key.
# (SECRET) - Required when LLM_PROVIDER=aiplatform
# Format: <secret-key>:<public-key>
# Example: sk-lf-xxxx-xxxx:pk-lf-xxxx-xxxx
AIPLATFORM_API_KEY=

# AI Platform base URL for API requests.
# Default: https://aiapidev.3ecompany.com
AIPLATFORM_BASE_URL=https://aiapidev.3ecompany.com

# AI Platform request timeout in seconds.
# Default: 120
# Increase for slow model responses or large payloads.
AIPLATFORM_TIMEOUT=120

# AI Platform chat completions endpoint path.
# Appended to AIPLATFORM_BASE_URL for chat requests.
# Default: /v1/chat/completions
AIPLATFORM_CHAT_PATH=/v1/chat/completions


# =============================================================================
# SECTION 5: HTTP Client Configuration
# =============================================================================
# Settings for HTTP client behavior including timeouts and retry logic.
# Applies to both LLM API calls and external tool HTTP requests.

# Long-running timeout for Ollama model calls and chat client requests.
# Default: 1200 seconds (20 minutes)
# Increase for complex reasoning tasks or slow model responses.
WEEKEND_WIZARD_REQUEST_TIMEOUT=1200

# External tool HTTP timeout for weather, books, joke, dog, and trivia fetches.
# Default: 20 seconds
# Lower than REQUEST_TIMEOUT since external tools should respond quickly.
WEEKEND_WIZARD_TOOL_HTTP_TIMEOUT=20

# Number of retry attempts for external tool HTTP requests after the first try.
# Default: 2 (total of 3 attempts including initial try)
# Valid values: 0 or positive integer
WEEKEND_WIZARD_HTTP_MAX_RETRIES=2

# Base retry backoff in seconds for external tool HTTP retries.
# Default: 0.5 seconds
# Uses exponential backoff: 0.5s, 1s, 2s, 4s, etc.
WEEKEND_WIZARD_HTTP_RETRY_BACKOFF_SECONDS=0.5


# =============================================================================
# SECTION 6: Observability & Logging
# =============================================================================
# Settings for application observability, logging, and monitoring.
# Controls how the application reports status and diagnostics.

# Application log level.
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: WARNING (production), INFO (debugging)
# Use INFO for debugging, WARNING for production to reduce noise.
WEEKEND_WIZARD_LOG_LEVEL=WARNING

# Observability mode for metrics and tracing collection.
# Valid values: 'local' | 'cloud' | 'disabled'
# - local: Local development observability (default)
# - cloud: Cloud-based observability platform integration
# - disabled: No observability collection
WEEKEND_WIZARD_OBSERVABILITY_MODE=local


# =============================================================================
# Claude SDK Notes
# =============================================================================
# Important notes for Claude SDK integration and authentication:
#
# - SDK dry-run commands do not require Claude authentication.
# - Live SDK runner commands require valid Claude SDK / Claude Code auth
#   available in the environment.
# - Live SDK smoke currently pre-checks ANTHROPIC_API_KEY.
# - Alternative company Claude Code auth paths are still pending clarification
#   on this branch.
#
# =============================================================================
